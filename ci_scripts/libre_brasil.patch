@@ -76,8 +76,81 @@ public class SensorPairingInfo: ObservableObject, Codable {
 
 }
 
+/// A local, exportable record of the NFC data used to identify a Libre sensor.
+///
+/// The encrypted FRAM is retained because it is required to investigate new
+/// sensor protocols. Trio never uploads this record. The user must explicitly
+/// share it from the setup screen.
+public struct SensorPairingDiagnostic: Codable, Equatable {
+    public let formatVersion: Int
+    public let capturedAt: Date
+    public let sensorUID: String
+    public let patchInfo: String
+    public let sensorType: String
+    public let framByteCount: Int
+    public let encryptedFramBase64: String
+    public let attemptedStreamingCommand: Bool
+    public let notes: String
+
+    public init(
+        formatVersion: Int = 1,
+        capturedAt: Date = Date(),
+        sensorUID: Data,
+        patchInfo: Data,
+        sensorType: SensorType,
+        encryptedFram: Data,
+        attemptedStreamingCommand: Bool,
+        notes: String
+    ) {
+        self.formatVersion = formatVersion
+        self.capturedAt = capturedAt
+        self.sensorUID = sensorUID.hexEncodedString().uppercased()
+        self.patchInfo = patchInfo.hexEncodedString().uppercased()
+        self.sensorType = sensorType.description
+        self.framByteCount = encryptedFram.count
+        self.encryptedFramBase64 = encryptedFram.base64EncodedString()
+        self.attemptedStreamingCommand = attemptedStreamingCommand
+        self.notes = notes
+    }
+
+    public var json: String {
+        let encoder = JSONEncoder()
+        encoder.dateEncodingStrategy = .iso8601
+        encoder.outputFormatting = [.prettyPrinted, .sortedKeys]
+
+        guard let data = try? encoder.encode(self),
+              let result = String(data: data, encoding: .utf8)
+        else {
+            return "Unable to encode Libre pairing diagnostic"
+        }
+
+        return result
+    }
+}
+
+public enum SensorPairingDiagnosticStore {
+    private static let latestDiagnosticKey = "com.loopkit.libre.pairing-diagnostic.latest"
+
+    public static var latest: SensorPairingDiagnostic? {
+        guard let data = UserDefaults.standard.data(forKey: latestDiagnosticKey) else {
+            return nil
+        }
+
+        return try? JSONDecoder().decode(SensorPairingDiagnostic.self, from: data)
+    }
+
+    public static func save(_ diagnostic: SensorPairingDiagnostic) {
+        guard let data = try? JSONEncoder().encode(diagnostic) else {
+            return
+        }
+
+        UserDefaults.standard.set(data, forKey: latestDiagnosticKey)
+    }
+}
+
 public protocol SensorPairingProtocol: AnyObject {
     var onCancel: (() -> Void)? { get set }
     var publisher: AnyPublisher<SensorPairingInfo, Never> { get }
+    var errorPublisher: AnyPublisher<Error, Never> { get }
     func pairSensor() throws
 }
