+
+/// Selects the protocol driver independently from the marketing sensor name.
+/// New regional variants can be identified without silently routing them to a
+/// protocol that writes incompatible commands to the sensor.
+public enum LibreDirectProtocol: String, CustomStringConvertible {
+    case europeanLibre2
+    case brazilLibre2Plus
+    case unsupported
+
+    public var supportsStreaming: Bool {
+        self == .europeanLibre2
+    }
+
+    public var description: String { rawValue }
+}
