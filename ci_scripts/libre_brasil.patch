+    /// Reads all 43 FRAM blocks in order. The previous implementation launched
+    /// every request concurrently and processed the data when the final request
+    /// happened to finish, which could produce a partial 344-byte capture.
+    private func readFRAM(
+        from tag: NFCISO15693Tag,
+        currentBlock: Int = 0,
+        collected: Data = Data(),
+        completion: @escaping (Result<Data, Error>) -> Void
+    ) {
+        let totalBlocks = 43
+        let blocksPerRequest = 3
+
+        guard currentBlock < totalBlocks else {
+            completion(.success(collected))
+            return
+        }
+
+        let blockCount = min(blocksPerRequest, totalBlocks - currentBlock)
+        let blockRange = NSRange(location: currentBlock, length: blockCount)
+
+        tag.readMultipleBlocks(
+            requestFlags: [.highDataRate, .address],
+            blockRange: blockRange
+        ) { blockArray, error in
+            if let error {
+                completion(.failure(error))
+                return
+            }
+
+            guard blockArray.count == blockCount else {
+                completion(.failure(PairingError.noSensorData))
+                return
+            }
+
+            var next = collected
+            blockArray.forEach { next.append($0) }
+
+            self.readFRAM(
+                from: tag,
+                currentBlock: currentBlock + blockCount,
+                collected: next,
+                completion: completion
+            )
+        }
+    }
+
+    /// Validates and classifies the sensor before any command that changes its
+    /// streaming state is sent.
+    private func completePairing(
+        session: NFCTagReaderSession,
+        tag: NFCISO15693Tag,
+        sensorUID: Data,
+        patchInfo: Data,
+        encryptedFram: Data
+    ) {
+        guard sensorUID.count == 8, patchInfo.count == 6, encryptedFram.count == 344 else {
+            session.invalidate(errorMessage: PairingError.noSensorData.localizedDescription)
+            sendError(PairingError.noSensorData)
+            return
+        }
+
+        let sensorType = SensorType(patchInfo: patchInfo)
+        let directProtocol = sensorType.directProtocol
+
+        guard directProtocol.supportsStreaming else {
+            let diagnostic = SensorPairingDiagnostic(
+                sensorUID: sensorUID,
+                patchInfo: patchInfo,
+                sensorType: sensorType,
+                encryptedFram: encryptedFram,
+                attemptedStreamingCommand: false,
+                notes: "Preflight NFC capture. No streaming command was sent for protocol \(directProtocol)."
+            )
+            SensorPairingDiagnosticStore.save(diagnostic)
+
+            let pairingError = PairingError.unsupportedDirectProtocol(diagnostic)
+            session.invalidate(errorMessage: pairingError.localizedDescription)
+            sendError(pairingError)
+            return
+        }
+
+        let subcommand: Subcommand = .enableStreaming
+        let command = nfcCommand(
+            subcommand,
+            unlockCode: unlockCode,
+            patchInfo: patchInfo,
+            sensorUID: sensorUID
+        )
+
+        tag.customCommand(
+            requestFlags: .highDataRate,
+            customCommandCode: Int(command.code),
+            customRequestParameters: command.parameters
+        ) { response, commandError in
+            let diagnostic = SensorPairingDiagnostic(
+                sensorUID: sensorUID,
+                patchInfo: patchInfo,
+                sensorType: sensorType,
+                encryptedFram: encryptedFram,
+                attemptedStreamingCommand: true,
+                notes: "European Libre 2 streaming response bytes: \(response.count); error: \(commandError?.localizedDescription ?? \"none\")."
+            )
+            SensorPairingDiagnosticStore.save(diagnostic)
+
+            let streamingEnabled = response.count == 6
+            let macAddress = streamingEnabled ? Data(response.reversed()).hexEncodedString().uppercased() : nil
+
+            do {
+                let decryptedBytes = try Libre2.decryptFRAM(
+                    type: sensorType,
+                    id: [UInt8](sensorUID),
+                    info: patchInfo,
+                    data: [UInt8](encryptedFram)
+                )
+
+                self.sendUpdate(SensorPairingInfo(
+                    uuid: sensorUID,
+                    patchInfo: patchInfo,
+                    fram: Data(decryptedBytes),
+                    streamingEnabled: streamingEnabled,
+                    macAddress: macAddress
+                ))
+                session.invalidate()
+            } catch {
+                session.invalidate(errorMessage: PairingError.decryptionError.localizedDescription)
+                self.sendError(PairingError.decryptionError)
+            }
+        }
+    }
