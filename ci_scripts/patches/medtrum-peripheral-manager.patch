+    private let completionLock = NSLock()
@@ -44,0 +46,11 @@ class PeripheralManager: NSObject {
+    /// A connection attempt has several asynchronous failure sources. Finish
+    /// it exactly once so a late Bluetooth callback cannot resume Trio's pump
+    /// continuation a second time.
+    private func finishConnection(_ error: MedtrumConnectError?) {
+        completionLock.lock()
+        let callback = completion
+        completion = nil
+        completionLock.unlock()
+        callback?(error)
+    }
